# ─── Sonora environment variables ───────────────────────────────────────────
# Copy to .env.local for local development. On Vercel, add these in
# Project → Settings → Environment Variables. Never commit real values.

# Server-side emotion analysis with Claude (recommended). Billed per use from
# console.anthropic.com; a Claude Pro/Max subscription does not include API access.
# Leave empty to rely on the on-device model (or manual mood selection).
ANTHROPIC_API_KEY=
# Optional model override. Defaults to claude-opus-5-5.
ANTHROPIC_MODEL=

# On-device model location (runs in the browser; text never leaves the device).
#   local -> served from public/models/<id>/ (generated by `npm run model:export`)
#   hub   -> loaded from the Hugging Face Hub repo <id> (e.g. your-name/sonora-emotion)
NEXT_PUBLIC_EMOTION_MODEL_HOST=local
NEXT_PUBLIC_EMOTION_MODEL_ID=sonora-emotion

# Accounts, favourites sync, playlists, history, mood journal (optional).
# Without these Sonora runs in guest mode with browser-only storage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used solely to delete the auth user on "Delete my account".
SUPABASE_SERVICE_ROLE_KEY=
