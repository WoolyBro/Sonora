# ─── Sonora environment variables ───────────────────────────────────────────
# Copy to .env.local for local development. On Vercel, add these in
# Project → Settings → Environment Variables. Never commit real values.

# Where Sonora's own emotion model is loaded from (it runs in the browser;
# text never leaves the device). No third-party AI service is used.
#   local -> served from public/models/<id>/ (committed to the repo; regenerate
#            with `npm run model:export`)
#   hub   -> loaded from the Hugging Face Hub repo <id> (e.g. your-name/sonora-emotion)
NEXT_PUBLIC_EMOTION_MODEL_HOST=local
NEXT_PUBLIC_EMOTION_MODEL_ID=sonora-emotion

# Accounts, favourites sync, playlists, history, mood journal (optional).
# Without these Sonora runs in guest mode with browser-only storage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used solely to delete the auth user on "Delete my account".
SUPABASE_SERVICE_ROLE_KEY=
